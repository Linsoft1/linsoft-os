#!/bin/sh
### BEGIN INIT INFO
# Provides: linsoft-dhcp
# Required-Start: $local_fs
# Required-Stop: $local_fs
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: Automatic DHCP configuration for detected interfaces
### END INIT INFO
case "$1" in
    start)
        echo "Linsoft: starting automatic network configuration"
        /usr/sbin/dhcpcd -b
        ;;
    stop)
        /usr/sbin/dhcpcd -x
        ;;
    restart)
        "$0" stop && "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 2
        ;;
esac
