#!/bin/bash
set -euo pipefail
target=/mnt/linsoft-debian-image
if [[ $EUID != 0 || ${LINSOFT_LFS_BUILD:-} != 1 ]]; then
    echo "Use root and LINSOFT_LFS_BUILD=1 on a separately mounted app image." >&2
    exit 2
fi
mountpoint -q "$target"
grep -qx 'ID=linsoft' "$target/etc/os-release"
source_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root="$target/opt/linsoft-debian"
if [[ -e $root ]]; then
    echo "App environment already exists; refusing to replace its installed data." >&2
    exit 1
fi
build=/mnt/lfs/sources/linsoft-debian/rootfs
test -f "$build/etc/debian_version"
if findmnt -rn -o TARGET | grep -q "^$build/"; then
    echo "Build root has live mounts; refusing to copy." >&2
    exit 1
fi
install -d "$target/opt"
cp -a -- "$build" "$root"
install -d "$root/etc/linsoft-apps" "$root/etc/xdg/tint2"
install -d "$root/usr/share/linsoft-apps"
install -d "$root/usr/lib/firefox-esr/distribution"
install -m0644 "$source_dir/debian/policies.json" "$root/usr/lib/firefox-esr/distribution/policies.json"
install -m0644 "$source_dir/debian/start.html" "$root/usr/share/linsoft-apps/start.html"
install -m0644 "$source_dir/debian/menu.xml" "$root/etc/linsoft-apps/menu.xml"
install -m0644 "$source_dir/debian/rc.xml" "$root/etc/linsoft-apps/rc.xml"
install -m0644 "$source_dir/debian/tint2rc" "$root/etc/xdg/tint2/tint2rc"
install -m0644 "$source_dir/debian/linsoft-browser.desktop" "$root/usr/share/applications/"
for program in linsoft-start-x linsoft-x-client linsoft-app-session linsoft-browser; do
    install -m0755 "$source_dir/debian/$program" "$root/usr/local/bin/$program"
done
for program in linsoft-debian linsoft-debian-desktop linsoft-deb-install; do
    install -m0755 "$source_dir/debian/$program" "$target/usr/bin/$program"
done
install -d "$target/usr/share/doc/linsoft-debian"
install -m0644 "$source_dir/debian/packages" "$target/usr/share/doc/linsoft-debian/requested-packages"
install -m0644 "$root/linsoft-debian-packages.txt" "$target/usr/share/doc/linsoft-debian/installed-packages"
echo "Separate Debian app environment installed; LFS system libraries unchanged."
