#!/bin/bash
# QEMU smoke test for the Linsoft live/installer ISO:
#   1. live boot (BIOS) reaches runlevel 3,
#   2. the installer GRUB entry installs to an empty virtual disk,
#   3. the installed disk boots on BIOS and on UEFI (OVMF),
#   plus USB-stick boots (BIOS, UEFI Secure Boot with one-time MokManager key
#   enrollment, a Rufus-style FAT copy) and the installed disk with Secure Boot.
set -euo pipefail
[[ $EUID == 0 ]] || { echo 'Run as root.' >&2; exit 2; }
iso=$(realpath "${1:?Usage: test-live-iso ISO [WORKDIR]}")
work=${2:-/var/tmp/linsoft-iso-test}
ovmf_code=/usr/share/OVMF/OVMF_CODE_4M.fd
ovmf_vars=/usr/share/OVMF/OVMF_VARS_4M.fd
ovmf_sb_code=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
ovmf_sb_vars=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
mkdir -p "$work"
cd "$work"
# LINSOFT_TEST_DUAL_ONLY=1 repeats only step 6 with the key enrolled earlier.
dual_only=${LINSOFT_TEST_DUAL_ONLY:-0}
if [[ $dual_only == 1 ]]; then
    [[ -f sb-vars.fd ]] || { echo 'Run the full test first (needs sb-vars.fd).' >&2; exit 2; }
    rm -f dual*.log* dual*.png mon.sock
else
    rm -f disk.qcow2 fatcopy.img sb-vars.fd ./*.log ./*.png mon.sock
fi
qemu-img create -f qcow2 disk.qcow2 20G >/dev/null
qemu_pid=''
stop_qemu() {
    [[ -n $qemu_pid ]] && kill "$qemu_pid" 2>/dev/null && wait "$qemu_pid" 2>/dev/null
    qemu_pid=''
    return 0
}
trap stop_qemu EXIT
monitor() { printf '%s\n' "$1" | nc -U -q1 "$work/mon.sock" >/dev/null 2>&1 || true; }
keys() { for key in "$@"; do monitor "sendkey $key"; sleep .3; done; }
start_qemu() {
    local log=$1; shift
    rm -f mon.sock
    qemu-system-x86_64 -enable-kvm -cpu host -m 3G -smp 2 \
        -drive file=disk.qcow2,format=qcow2,if=virtio \
        -device virtio-vga,xres=1280,yres=800 -device qemu-xhci -device usb-tablet \
        -netdev user,id=n -device virtio-net-pci,netdev=n \
        -display none -serial "file:$log" \
        -monitor "unix:$work/mon.sock,server,nowait" "$@" > "$log.qemu" 2>&1 &
    qemu_pid=$!
    for attempt in $(seq 1 50); do [[ -S mon.sock ]] && break; sleep .2; done
}
wait_serial() {
    local log=$1 pattern=$2 timeout=$3
    for attempt in $(seq 1 "$timeout"); do
        tr -d '\r' < "$log" 2>/dev/null | grep -qE "$pattern" && return 0
        kill -0 "$qemu_pid" 2>/dev/null || return 1
        sleep 1
    done
    return 1
}
pass() { echo "PASS: $*"; }
fail() { echo "FAIL: $*" >&2; exit 1; }
usb() { usb_args=(-drive "if=none,id=usbstick,format=raw,snapshot=on,file=$1"
    -device usb-storage,drive=usbstick,removable=on,bootindex=0); }
sb_args=(-machine q35,smm=on -global driver=cfi.pflash01,property=secure,value=on
    -drive "if=pflash,format=raw,readonly=on,file=$ovmf_sb_code"
    -drive if=pflash,format=raw,file=sb-vars.fd)
# Shim starts MokManager because the Linsoft key is not enrolled yet:
# Enroll key from disk -> LINSOFT_EFI -> linsoft-secureboot.cer -> Continue -> Yes -> Reboot.
enroll_mok() {
    local log=$1
    wait_serial "$log" 'Verification failed' 90 || fail 'shim did not report the unenrolled key'
    keys ret
    wait_serial "$log" 'Press any key' 20 || fail 'MokManager did not start'
    keys ret; sleep 2
    keys down ret; sleep 2
    keys ret; sleep 2
    keys down ret; sleep 2
    monitor "screendump $work/mok-enroll.png -f png"
    keys down ret; sleep 1
    keys down ret; sleep 2
    : > "$log"
    keys ret
}

if [[ $dual_only != 1 ]]; then
echo '--- 1. Live boot (BIOS)'
start_qemu live.log -cdrom "$iso" -boot d
wait_serial live.log 'linsoft login:' 180 || fail 'live system did not reach login prompt'
sleep 25
monitor "screendump $work/live.png -f png"
grep -q 'SQUASHFS error' "$work/live.log" && fail 'squashfs xattr error in live boot'
pass 'live system booted'
stop_qemu

echo '--- 1b. Live boot (UEFI)'
cp "$ovmf_vars" vars.fd
start_qemu live-uefi.log -machine q35 -cdrom "$iso" \
    -drive if=pflash,format=raw,readonly=on,file="$ovmf_code" \
    -drive if=pflash,format=raw,file=vars.fd
wait_serial live-uefi.log 'linsoft login:' 240 || fail 'live system did not boot on UEFI'
pass 'live system booted on UEFI'
stop_qemu

echo '--- 1c. Live boot from USB stick (BIOS, hybrid MBR)'
usb "$iso"
start_qemu live-usb-bios.log "${usb_args[@]}"
wait_serial live-usb-bios.log 'linsoft login:' 180 || fail 'live USB did not boot on BIOS'
pass 'live USB boots on BIOS'
stop_qemu

echo '--- 1d. Live boot from USB stick (UEFI Secure Boot, first start)'
cp "$ovmf_sb_vars" sb-vars.fd
start_qemu live-usb-sb.log "${sb_args[@]}" "${usb_args[@]}"
enroll_mok live-usb-sb.log
wait_serial live-usb-sb.log 'linsoft login:' 240 ||
    fail 'live USB did not boot with Secure Boot after key enrollment'
pass 'Linsoft key enrolled, live USB boots with Secure Boot'
stop_qemu

echo '--- 1e. Rufus ISO-mode copy (FAT32 USB stick, UEFI Secure Boot)'
truncate -s $(( $(stat -c %s "$iso") + 512 * 1024 * 1024 )) fatcopy.img
/usr/sbin/mkfs.fat -F 32 -n LINSOFT fatcopy.img >/dev/null
fat_src=$work/iso-mnt
mkdir -p "$fat_src"
mount -o ro,loop "$iso" "$fat_src"
mcopy -s -i fatcopy.img "$fat_src"/* ::/ || { umount "$fat_src"; fail 'FAT copy failed'; }
umount "$fat_src"
usb "$work/fatcopy.img"
start_qemu live-fat-sb.log "${sb_args[@]}" "${usb_args[@]}"
wait_serial live-fat-sb.log 'linsoft login:' 240 ||
    fail 'Rufus-style FAT copy did not boot with Secure Boot'
grep -q 'Verification failed' live-fat-sb.log && fail 'enrolled key was not remembered'
pass 'Rufus-style FAT copy boots with Secure Boot'
stop_qemu
rm -f fatcopy.img

echo '--- 2. Installer entry'
start_qemu install.log -cdrom "$iso" -boot d
wait_serial install.log 'executed automatically' 60 || fail 'GRUB menu not shown'
keys down ret
wait_serial install.log 'linsoft login:' 180 ||
    fail 'installer boot did not start'
sleep 20
monitor "screendump $work/installer-start.png -f png"
keys 1 ret
sleep 3
keys ret
sleep 2
keys shift-a shift-n shift-o ret
previous=0; stable=0
for attempt in $(seq 1 180); do
    sleep 5
    size=$(stat -c %s disk.qcow2)
    if (( size == previous && size > 3000000000 )); then
        stable=$((stable + 1))
        (( stable >= 6 )) && break
    else
        stable=0
    fi
    previous=$size
done
monitor "screendump $work/installer-done.png -f png"
keys v ret
for attempt in $(seq 1 60); do kill -0 "$qemu_pid" 2>/dev/null || break; sleep 1; done
stop_qemu
(( $(stat -c %s disk.qcow2) > 3000000000 )) || fail 'installer did not write the system'
pass 'installer wrote the disk'

echo '--- 3. Installed disk (BIOS)'
start_qemu bios.log -boot c
wait_serial bios.log 'linsoft login:' 180 || fail 'installed system did not boot on BIOS'
grep -q 'FAILED' "$work/bios.log" &&
    echo 'WARN: boot log contains FAILED lines' >&2
sleep 25
monitor "screendump $work/installed-bios.png -f png"
pass 'installed system boots on BIOS'
stop_qemu

echo '--- 4. Installed disk (UEFI)'
cp "$ovmf_vars" vars.fd
start_qemu uefi.log -machine q35 \
    -drive if=pflash,format=raw,readonly=on,file="$ovmf_code" \
    -drive if=pflash,format=raw,file=vars.fd
wait_serial uefi.log 'linsoft login:' 240 || fail 'installed system did not boot on UEFI'
sleep 25
monitor "screendump $work/installed-uefi.png -f png"
pass 'installed system boots on UEFI'
stop_qemu

echo '--- 5. Installed disk (UEFI Secure Boot, key enrolled from the live USB)'
start_qemu uefi-sb.log "${sb_args[@]}"
wait_serial uefi-sb.log 'linsoft login:' 240 ||
    fail 'installed system did not boot with Secure Boot'
grep -q 'Verification failed' uefi-sb.log && fail 'installed system asked for the key again'
pass 'installed system boots with Secure Boot'
stop_qemu
fi

echo '--- 6. Dual boot next to Windows (UEFI Secure Boot, user password)'
# A GPT disk like a Windows PC after "Shrink Volume": ESP with the Windows
# boot manager, a data partition and 16 GiB of unpartitioned space.
rm -f disk.qcow2
qemu-img create -f qcow2 disk.qcow2 28G >/dev/null
modprobe nbd max_part=16 2>/dev/null || true
nbd=''
for dev in /dev/nbd{0..15}; do
    [[ -b $dev && $(cat "/sys/block/${dev#/dev/}/size") == 0 ]] && { nbd=$dev; break; }
done
[[ -n $nbd ]] || fail 'no free NBD device'
qemu-nbd -c "$nbd" disk.qcow2
sfdisk -q "$nbd" <<'EOF'
label: gpt
size=260MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="EFI system partition"
size=16MiB, type=E3C9E316-0B5C-4DB8-817D-F92DF00215AE, name="Microsoft reserved partition"
size=11GiB, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name="Basic data partition"
EOF
for attempt in $(seq 1 50); do [[ -b ${nbd}p3 ]] && break; sleep .2; done
/usr/sbin/mkfs.fat -F 32 -n SYSTEM "${nbd}p1" >/dev/null
esp_dir=$work/esp-mnt
mkdir -p "$esp_dir"
mount "${nbd}p1" "$esp_dir"
mkdir -p "$esp_dir/EFI/Microsoft/Boot"
echo 'fake Windows boot manager' > "$esp_dir/EFI/Microsoft/Boot/bootmgfw.efi"
umount "$esp_dir"
head -c 64M /dev/urandom > "$work/windows-data"
dd if="$work/windows-data" of="${nbd}p3" bs=1M conv=fsync status=none
windows_sum=$(head -c 64M "${nbd}p3" | sha256sum)
qemu-nbd -d "$nbd" >/dev/null
start_qemu dual.log "${sb_args[@]}" \
    -drive "if=none,id=cd,media=cdrom,readonly=on,file=$iso" -device ide-cd,drive=cd,bootindex=0
wait_serial dual.log 'executed automatically' 90 || fail 'GRUB menu not shown (dual boot)'
keys down ret
wait_serial dual.log 'linsoft login:' 240 || fail 'installer boot did not start (dual boot)'
sleep 20
keys 1 ret
sleep 3
monitor "screendump $work/dual-mode.png -f png"
keys 2 ret
sleep 2
keys t e s t 1 2 3 4 ret
sleep 1
keys t e s t 1 2 3 4 ret
sleep 2
keys shift-a shift-n shift-o ret
previous=0; stable=0
for attempt in $(seq 1 180); do
    sleep 5
    size=$(stat -c %s disk.qcow2)
    if (( size == previous && size > 3000000000 )); then
        stable=$((stable + 1))
        (( stable >= 6 )) && break
    else
        stable=0
    fi
    previous=$size
done
monitor "screendump $work/dual-done.png -f png"
keys v ret
for attempt in $(seq 1 60); do kill -0 "$qemu_pid" 2>/dev/null || break; sleep 1; done
stop_qemu
qemu-nbd -c "$nbd" disk.qcow2
for attempt in $(seq 1 50); do [[ -b ${nbd}p4 ]] && break; sleep .2; done
[[ -b ${nbd}p4 ]] || { qemu-nbd -d "$nbd" >/dev/null; fail 'dual boot partition was not created'; }
[[ $(head -c 64M "${nbd}p3" | sha256sum) == "$windows_sum" ]] ||
    { qemu-nbd -d "$nbd" >/dev/null; fail 'Windows partition was modified'; }
root_dir=$work/root-mnt
mkdir -p "$root_dir"
mount -o ro "${nbd}p4" "$root_dir"
mount -o ro "${nbd}p1" "$esp_dir"
checks=''
[[ -f $esp_dir/EFI/linsoft/shimx64.efi && -f $esp_dir/EFI/linsoft/grubx64.efi ]] || checks+=' loaders'
[[ -f $esp_dir/EFI/Microsoft/Boot/bootmgfw.efi ]] || checks+=' windows-loader'
grep -q "menuentry 'Windows'" "$root_dir/boot/grub/grub.cfg" || checks+=' grub-windows'
grep -q '^UTC=0' "$root_dir/etc/sysconfig/clock" || checks+=' clock'
grep -q '^linsoft:\$' "$root_dir/opt/linsoft-debian/etc/shadow" || checks+=' password'
[[ ! -e $root_dir/opt/linsoft-debian/etc/linsoft-apps/autologin ]] || checks+=' autologin'
umount "$esp_dir" "$root_dir"
qemu-nbd -d "$nbd" >/dev/null
[[ -z $checks ]] || fail "dual boot install incomplete:$checks"
pass 'installed next to Windows; Windows data untouched; password set'
# Without the removable fallback loader only the NVRAM entry can start Linsoft.
qemu-nbd -c "$nbd" disk.qcow2
for attempt in $(seq 1 50); do [[ -b ${nbd}p1 ]] && break; sleep .2; done
mount "${nbd}p1" "$esp_dir"
rm -f "$esp_dir/EFI/BOOT/BOOTX64.EFI"
umount "$esp_dir"
qemu-nbd -d "$nbd" >/dev/null
start_qemu dual-boot.log "${sb_args[@]}"
wait_serial dual-boot.log 'Windows' 120 || fail 'GRUB does not offer Windows'
wait_serial dual-boot.log 'linsoft login:' 240 || fail 'dual boot system did not start'
grep -q 'Verification failed' dual-boot.log && fail 'dual boot system asked for the key again'
sleep 40
monitor "screendump $work/dual-locked.png -f png"
pass 'dual boot system starts with Secure Boot and offers Windows'
stop_qemu
echo 'All Linsoft ISO tests passed.'
