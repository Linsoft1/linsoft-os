#!/bin/bash
# Builds the Secure Boot capable UEFI loader set for Linsoft OS:
#   BOOTX64.EFI  Microsoft-signed shim (Ubuntu shim-signed)
#   grubx64.efi  GRUB with all modules built in, signed with the Linsoft key
#   mmx64.efi    MokManager, used once to enroll the Linsoft key
#   linsoft-secureboot.cer  public Linsoft key for MokManager
# Usage: build-signed-efi OUT_DIR [UNSIGNED_KERNEL...]
# Each kernel given is signed in place with the Linsoft key.
# The private key stays in $LINSOFT_SB_KEYDIR (default /root/linsoft-secureboot).
set -euo pipefail
out=${1:?Usage: build-signed-efi OUT_DIR [UNSIGNED_KERNEL...]}
shift
keydir=${LINSOFT_SB_KEYDIR:-/root/linsoft-secureboot}
shim=/usr/lib/shim/shimx64.efi.signed.latest
mokmanager=/usr/lib/shim/mmx64.efi
for f in "$keydir/linsoft-sb.key" "$keydir/linsoft-sb.crt" "$keydir/linsoft-sb.cer" \
         "$shim" "$mokmanager"; do
    [[ -f $f ]] || { echo "Missing $f (shim-signed package or Linsoft key)." >&2; exit 1; }
done
command -v sbsign >/dev/null || { echo 'sbsigntool is required.' >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/sbat.csv" <<'EOF'
sbat,1,SBAT Version,sbat,1,https://github.com/rhboot/shim/blob/main/SBAT.md
grub,5,Free Software Foundation,grub,2.12,https://www.gnu.org/software/grub/
grub.linsoft,1,Linsoft OS,grub2,2.12,https://github.com/Linsoft1/linsoft-os
EOF
# Under Secure Boot GRUB refuses to load modules from disk, so everything
# the ISO and installed configurations use is built into the image.
grub-mkimage -O x86_64-efi -p /EFI/BOOT --sbat "$tmp/sbat.csv" -o "$tmp/grubx64.efi" \
    part_gpt part_msdos fat iso9660 ext2 normal configfile search search_fs_uuid \
    search_fs_file search_label linux echo test true ls cat sleep reboot halt \
    all_video efi_gop efi_uga video_bochs video_cirrus gfxterm gfxterm_background \
    gfxmenu png font serial terminal gzio minicmd regexp loadenv efifwsetup chain
mkdir -p "$out"
sbsign --key "$keydir/linsoft-sb.key" --cert "$keydir/linsoft-sb.crt" \
    --output "$out/grubx64.efi" "$tmp/grubx64.efi" 2>/dev/null
install -m 0644 "$shim" "$out/BOOTX64.EFI"
install -m 0644 "$mokmanager" "$out/mmx64.efi"
install -m 0644 "$keydir/linsoft-sb.cer" "$out/linsoft-secureboot.cer"

bash "$(dirname "$0")/sign-kernel" "$@"
