# Required results
!y BLK_DEV_NVME
!y VMD
!y FW_LOADER_COMPRESS_XZ
!m IWLWIFI
!m IWLMVM
!m RTW88_8822CE
!m RTW89_8852BE
!m MT7921E
!m ATH11K_PCI
!m DRM_I915
!m DRM_AMDGPU
!m DRM_NOUVEAU
!m I2C_HID_ACPI
!m HID_MULTITOUCH
!m SND_SOC_SOF_PCI
!m SND_SOC_SOF_TIGERLAKE
!m BT_HCIBTUSB
