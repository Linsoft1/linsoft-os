# Linsoft kernel hardware support for real PCs (Linsoft OS 1.2).
# Format: y|m|n OPTION  (without the CONFIG_ prefix). Lines starting with '!'
# must be present in the final .config with that value or the build fails.

# Boot storage that must work before udev (installed disk, Live USB)
y VMD
y BLK_DEV_NVME
y SATA_AHCI
y USB_XHCI_HCD
y USB_XHCI_PCI
y USB_EHCI_HCD
y USB_STORAGE
y USB_UAS
y FW_LOADER
y FW_LOADER_COMPRESS
y FW_LOADER_COMPRESS_XZ
y FW_LOADER_COMPRESS_ZSTD
m MISC_RTSX_PCI
m MISC_RTSX_USB
m MMC_REALTEK_PCI
m MMC_REALTEK_USB
m USB4
m THUNDERBOLT

# Wi-Fi: Intel, Realtek, MediaTek, Qualcomm/Atheros, Broadcom
m IWLWIFI
m IWLDVM
m IWLMVM
m IWLMLD
y RTW88
m RTW88_8822BE
m RTW88_8822CE
m RTW88_8723DE
m RTW88_8821CE
m RTW88_8814AE
m RTW88_8822BU
m RTW88_8822CU
m RTW88_8723DU
m RTW88_8821CU
m RTW88_8821AU
m RTW88_8812AU
m RTW89
m RTW89_8851BE
m RTW89_8852AE
m RTW89_8852BE
m RTW89_8852BTE
m RTW89_8852CE
m RTW89_8922AE
m RTL8XXXU
y RTL8XXXU_UNTESTED
m RTL_CARDS
m RTL8192CE
m RTL8192SE
m RTL8192DE
m RTL8723AE
m RTL8723BE
m RTL8188EE
m RTL8192EE
m RTL8821AE
m RTL8192CU
m MT7601U
m MT76x0U
m MT76x2U
m MT7921E
m MT7921U
m MT7925E
m MT7925U
m MT7915E
m ATH9K
m ATH9K_HTC
m ATH10K
m ATH10K_PCI
m ATH11K
m ATH11K_PCI
m ATH12K
m BRCMFMAC
y BRCMFMAC_PCIE
y BRCMFMAC_USB
m BRCMSMAC
m RT2X00
m RT2800USB
m RT2800PCI
m MHI_BUS
m QRTR
m QRTR_MHI

# Ethernet (PCIe and USB adapters)
m E1000
m IGB
m IGC
m IXGBE
m ATL1C
m ALX
m ATLANTIC
m TIGON3
m BNX2
m R8169
m USB_RTL8152
m USB_USBNET
m USB_NET_AX8817X
m USB_NET_AX88179_178A
m USB_NET_CDCETHER
m USB_NET_CDC_NCM
m USB_NET_RNDIS_HOST

# Graphics: AMD, older Radeon, NVIDIA (nouveau), Intel Xe
m DRM_AMDGPU
y DRM_AMDGPU_SI
y DRM_AMDGPU_CIK
y DRM_AMD_DC
m DRM_RADEON
m DRM_NOUVEAU
m DRM_XE
# Module, so GuC/HuC/DMC firmware is loaded from the root filesystem.
m DRM_I915
y DRM_SIMPLEDRM
m BACKLIGHT_CLASS_DEVICE

# Laptop input: touchpads, touch screens, hotkeys
m I2C_HID_ACPI
m HID_MULTITOUCH
m HID_RMI
m RMI4_CORE
m MOUSE_ELAN_I2C
y MOUSE_ELAN_I2C_I2C
m MOUSE_SYNAPTICS_I2C
