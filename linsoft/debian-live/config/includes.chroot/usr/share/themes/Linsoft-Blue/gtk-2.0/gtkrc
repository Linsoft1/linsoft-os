gtk-color-scheme = "base_color: #0b1220"
gtk-color-scheme = "text_color: #e6edf7"
gtk-color-scheme = "bg_color: #111a2a"
gtk-color-scheme = "fg_color: #e6edf7"
gtk-color-scheme = "selected_bg_color: #287ff0"
gtk-color-scheme = "selected_fg_color: #ffffff"
gtk-color-scheme = "insensitive_bg_color: #182235"
gtk-color-scheme = "insensitive_fg_color: #738198"
gtk-color-scheme = "tooltip_bg_color: #172236"
gtk-color-scheme = "tooltip_fg_color: #e6edf7"

gtk-icon-theme-name = "Linsoft-Icons"
gtk-font-name = "DejaVu Sans 10"
gtk-primary-button-warps-slider = 1

style "linsoft-default" {
  fg[NORMAL] = "#e6edf7"
  fg[PRELIGHT] = "#ffffff"
  fg[ACTIVE] = "#ffffff"
  fg[SELECTED] = "#ffffff"
  fg[INSENSITIVE] = "#738198"
  bg[NORMAL] = "#111a2a"
  bg[PRELIGHT] = "#223149"
  bg[ACTIVE] = "#1d4e88"
  bg[SELECTED] = "#287ff0"
  bg[INSENSITIVE] = "#182235"
  base[NORMAL] = "#0b1220"
  base[ACTIVE] = "#172236"
  base[SELECTED] = "#287ff0"
  base[INSENSITIVE] = "#182235"
  text[NORMAL] = "#e6edf7"
  text[ACTIVE] = "#ffffff"
  text[SELECTED] = "#ffffff"
  text[INSENSITIVE] = "#738198"
}

class "*" style "linsoft-default"
