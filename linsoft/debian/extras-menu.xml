<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Linsoft OS">
    <item label="Vyhladat aplikacie"><action name="Execute"><command>xfce4-appfinder --disable-server</command></action></item>
    <separator/>
    <item label="Internet - Firefox"><action name="Execute"><command>/usr/local/bin/linsoft-browser</command></action></item>
    <item label="Dokumenty - Writer"><action name="Execute"><command>libreoffice --writer</command></action></item>
    <item label="Tabulky - Calc"><action name="Execute"><command>libreoffice --calc</command></action></item>
    <item label="Subory"><action name="Execute"><command>pcmanfm /home/linsoft</command></action></item>
    <item label="Kos"><action name="Execute"><command>pcmanfm trash:///</command></action></item>
    <item label="Terminal"><action name="Execute"><command>xterm -fa 'DejaVu Sans Mono' -fs 11 -bg '#111d30' -fg '#e3effb'</command></action></item>
    <separator/>
    <item label="Nastavenia"><action name="Execute"><command>/usr/local/bin/linsoft-settings</command></action></item>
    <item label="Spravca uloh"><action name="Execute"><command>xfce4-taskmanager</command></action></item>
    <item label="Instalovat doveryhodny DEB"><action name="Execute"><command>/usr/local/bin/linsoft-install-package</command></action></item>
    <item label="O Linsoft OS"><action name="Execute"><command>/usr/local/bin/linsoft-settings about</command></action></item>
    <separator/>
    <item label="Povodna plocha / systemove nastroje"><action name="Execute"><command>/usr/local/bin/linsoft-session-action drm</command></action></item>
    <item label="Restartovat"><action name="Execute"><command>/usr/local/bin/linsoft-session-action restart</command></action></item>
    <item label="Vypnut"><action name="Execute"><command>/usr/local/bin/linsoft-session-action poweroff</command></action></item>
  </menu>
</openbox_menu>
