#!/bin/bash
set -euo pipefail
source_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for entry in linsoft-menu linsoft-files linsoft-terminal linsoft-install-package; do
    if LC_ALL=C grep -q $'\r' "$source_dir/debian/$entry.desktop"; then
        echo "$entry.desktop must use LF line endings for tint2." >&2
        exit 1
    fi
done
temporary=$(mktemp -d)
cleanup() {
    rm -f -- "$temporary/zenity" "$temporary/openbox" "$temporary/events" \
        "$temporary/errors" "$temporary/test.deb" "$temporary/linsoft-native"
    rmdir "$temporary"
}
trap cleanup EXIT
cat > "$temporary/zenity" <<'MOCK'
#!/bin/bash
printf 'zenity %s\n' "$*" >> "$EVENTS"
exit "${ZENITY_RESULT:-0}"
MOCK
cat > "$temporary/openbox" <<'MOCK'
#!/bin/bash
printf 'openbox %s\n' "$*" >> "$EVENTS"
MOCK
chmod 0755 "$temporary/zenity" "$temporary/openbox"
cat > "$temporary/linsoft-native" <<'MOCK'
#!/bin/bash
printf 'linsoft-native %s\n' "$*" >> "$EVENTS"
MOCK
chmod 0755 "$temporary/linsoft-native"
export PATH="$temporary:$PATH" EVENTS="$temporary/events"
export LINSOFT_PRIMARY=1 ZENITY_RESULT=1
bash "$source_dir/debian/linsoft-session-action" poweroff
! grep -q openbox "$EVENTS"
export ZENITY_RESULT=255
if bash "$source_dir/debian/linsoft-session-action" restart 2>"$temporary/errors"; then
    echo "Dialog failure was incorrectly accepted." >&2
    exit 1
fi
grep -q 'confirmation dialog failed' "$temporary/errors"
if bash "$source_dir/debian/linsoft-install-package" 2>"$temporary/errors"; then
    echo "File selector failure was incorrectly accepted." >&2
    exit 1
fi
grep -q 'package selector failed' "$temporary/errors"
export ZENITY_RESULT=0 LINSOFT_PRIMARY=0
if bash "$source_dir/debian/linsoft-session-action" poweroff; then
    echo "Secondary session accepted a privileged action." >&2
    exit 1
fi
bash "$source_dir/debian/linsoft-session-action" drm
grep -q 'openbox --exit' "$EVENTS"
: > "$EVENTS"
export LINSOFT_NATIVE=1
bash "$source_dir/debian/linsoft-session-action" drm
grep -qx 'linsoft-native --quit' "$EVENTS"
! grep -q '^openbox ' "$EVENTS"
unset LINSOFT_NATIVE
: > "$EVENTS"
export LINSOFT_PRIMARY=1
if bash "$source_dir/debian/linsoft-session-action" install /does-not-exist.deb; then
    echo "Missing package was incorrectly accepted." >&2
    exit 1
fi
! grep -q openbox "$EVENTS"
touch "$temporary/test.deb"
export ZENITY_RESULT=1
bash "$source_dir/debian/linsoft-session-action" install "$temporary/test.deb"
! grep -q openbox "$EVENTS"
echo "PASS: action cancellation, explicit dialog errors, invalid package, secondary-session restrictions and DRM exit"
